{
  "comment": "Full screenshot pass: panel tile, tile menu (peak summary), expanded readings, a real Quiet -> Performance fan response through the system service, the temperature tile, and the preferences window.",
  "target": "@TARGET@",
  "outdir": "@OUTDIR@",
  "steps": [
    {"at": 4.0, "do": "note", "text": "session ready"},
    {"at": 4.5, "do": "overview-state"},
    {"at": 5.0, "do": "open-panel"},
    {"at": 6.5, "do": "shot", "name": "01-quick-settings"},
    {"at": 7.5, "do": "open-menu"},
    {"at": 9.0, "do": "shot", "name": "02-menu-peak"},
    {"at": 9.5, "do": "toggle-details"},
    {"at": 11.0, "do": "shot", "name": "03-menu-expanded"},
    {"at": 12.0, "do": "set-mode", "mode": "quiet"},
    {"at": 13.0, "do": "series", "name": "fan-curve-1", "count": 7, "interval": 2000},
    {"at": 28.0, "do": "set-mode", "mode": "performance"},
    {"at": 29.0, "do": "series", "name": "fan-curve-2", "count": 9, "interval": 2000},
    {"at": 48.0, "do": "toggle-details"},
    {"at": 49.0, "do": "close-panel"},
    {"at": 49.5, "do": "setting", "key": "show-temperature", "value": true},
    {"at": 50.5, "do": "open-panel"},
    {"at": 52.0, "do": "shot", "name": "04-tile-temperature"},
    {"at": 53.0, "do": "setting", "key": "show-temperature", "value": false},
    {"at": 53.5, "do": "close-panel"},
    {"at": 55.0, "do": "open-panel"},
    {"at": 56.0, "do": "open-menu"},
    {"at": 57.5, "do": "set-mode", "mode": "balanced"},
    {"at": 60.0, "do": "shot", "name": "06-mode-change"},
    {"at": 61.0, "do": "set-mode", "mode": "performance"},
    {"at": 62.0, "do": "close-panel"},
    {"at": 64.0, "do": "prefs-window"},
    {"at": 68.5, "do": "shot", "name": "05-preferences"},
    {"at": 70.0, "do": "close-prefs-window"},
    {"at": 71.5, "do": "done"}
  ]
}
